generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Event {
  id                  String      @id @default(uuid())
  limitlessId         String?     @unique
  source              String
  title               String
  description         String?
  status              EventStatus @default(open)
  onPlatform          Boolean     @default(false)
  dismissed           Boolean     @default(false)
  contractEventId     String?
  contractTxHash      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  syncedAt            DateTime?
  categories          String[]    @default([])
  conditionId         String?
  expirationTimestamp Float?
  marketType          String?
  slug                String?
  tags                String[]    @default([])
  resolutionTypeTuple String?
  votingDeadlineTs    Float?
}

model Admin {
  id            String   @id
  walletAddress String   @unique
  label         String?
  createdAt     DateTime @default(now())
}

enum EventStatus {
  open
  resolved
  cancelled
}
